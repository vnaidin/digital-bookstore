<head>
  <meta charset="UTF-8" />
  <meta name="format-detection" content="telephone=no">
  <title>Email</title>
  <link href="https://fonts.googleapis.com/css?family=Roboto:400,500&display=swap" rel="stylesheet" />
  <style>
    table {
      margin: 0;
      padding: 0;
      border-collapse: collapse;
    }

    span {
      -webkit-text-size-adjust: none;
    }

    img {
      border: 0;
      display: block;
    }

    hr {
      border: none;
      color: #e1e1e1;
      background-color: #e1e1e1;
      height: 1px;
    }

    .padding-wrapper {
      padding: 0 30px;
    }

    .padding-wrapper--top {
      padding-top: 24px;
    }

    .padding-wrapper--bottom {
      padding-bottom: 24px;
    }

    .email-title {
      font-family: "Roboto", "Arial", sans-serif;
      color: #000000;
      margin: 0;
      text-align: left;
      font-style: normal;
      font-weight: 500;
      font-size: 24px;
      line-height: 28px;
      display: flex;
      align-items: center;
    }

    .email-link {
      color: #58606b !important;
      -webkit-text-size-adjust: none;
    }

    .email-text {
      font-family: "Roboto", "Arial", sans-serif;
      font-weight: 400;
      color: #000000 !important;
      font-style: normal;
      font-size: 16px;
      line-height: 26px;
      -webkit-text-size-adjust: none;
    }

    .im {
      color: #000000 !important;
    }
  </style>
</head>
